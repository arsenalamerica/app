# Environment schema — committed and safe to read.
#
# This file is the single source of truth for every env var this app uses. It
# contains no plaintext secrets: sensitive values are `op://` references that
# varlock resolves from 1Password at load time.
#
# Local dev authenticates with a 1Password service account scoped to the
# arsenalamerica-app vault only. That uses the bundled WASM SDK, so no `op` CLI
# and no desktop app are needed. See README.md for getting the token.
#
# CI and Vercel do NOT use 1Password. They supply values as real environment
# variables (GitHub secrets / Vercel project env), which take precedence over
# everything here and short-circuit the `op()` resolvers entirely.
#
# @currentEnv=$VARLOCK_ENV
# @generateTsTypes(path=env.d.ts)
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN)
# ---

# Service account token for the arsenalamerica-app vault. Set it in the
# gitignored .env.local, encrypted at rest — see README.md. @internal keeps it
# out of the application env; it is only used to resolve the items below.
# Unset in CI and on Vercel, which never reach the op() resolvers.
# @optional @sensitive @internal @type=opServiceAccountToken
OP_TOKEN=

# Sportmonks API token. Required for fixtures, standings, and the sync scripts.
#
# Under `test` this short-circuits to a placeholder so `yarn test` never calls
# 1Password: unit tests must run offline, with no Touch ID prompt, and in CI
# where no vault credential exists. Everywhere else it resolves from 1Password,
# unless process.env already supplies it (CI and Vercel), which skips op()
# entirely.
#
# @required @sensitive
# @docs(https://docs.sportmonks.com/football/welcome/authentication)
MONK_TOKEN=if(forEnv(test), test-token-placeholder, op(op://arsenalamerica-app/sportmonks/credential))

# Sentry source-map upload token. Only set in CI and on Vercel; local builds
# skip the upload silently when this is absent.
# @optional @sensitive
SENTRY_AUTH_TOKEN=

# Bypasses Vercel deployment protection so e2e tests can hit preview URLs.
# Only set in CI.
# @optional @sensitive
VERCEL_BYPASS_SECRET=

# Target for the Playwright suite. CI overrides this with the preview URL.
# @optional @public @type=url
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Injected by Vercel. Absent locally, which is how tenant resolution and the
# metadata routes detect a dev environment.
# @optional @public @type=enum(development, preview, production)
VERCEL_ENV=

# Client-side mirror of VERCEL_ENV, used to tag browser Sentry events. Vercel
# does NOT populate this automatically — it must be set in project settings.
# @optional @public @type=enum(development, preview, production)
NEXT_PUBLIC_VERCEL_ENV=
